    },
    {
      "scene": "3 — Le paquet",
      "character_id": "agnes",
      "speaker": "Agnès",
      "pause_after_ms": 260,
      "text": "Alors donne-le-moi.",
      "voice": "fr-FR-EloiseNeural",
      "rate": "+0%",
      "pitch": "-4Hz",
      "volume": "+2%"
    },
    {
      "scene": "3 — Le paquet",
      "character_id": "etienne",
      "speaker": "Étienne",
      "pause_after_ms": 350,
      "text": "Je vous le donne à tous les deux. Si l'un tombe à l'eau, l'autre continue.",
      "preset": "marin-bourru"
    },
    {
      "scene": "3 — Le paquet",
      "character_id": "martin",
      "speaker": "Martin",
      "pause_after_ms": 260,
      "text": "Pourquoi est-ce que ce serait moi qui tombe à l'eau ?",
      "voice": "fr-FR-RemyMultilingualNeural",
      "rate": "+10%",
      "pitch": "+26Hz",
      "volume": "+3%"
    },
    {
      "scene": "3 — Le paquet",
      "character_id": "agnes",
      "speaker": "Agnès",
      "pause_after_ms": 500,
      "text": "Parce que tu viens de demander.",
      "voice": "fr-FR-EloiseNeural",
      "rate": "+3%",
      "pitch": "-2Hz",
      "volume": "+2%"
    },
    {
      "scene": "4 — Ce qui ferme une parole",
      "character_id": "narrateur",
      "speaker": "Narratrice",
      "pause_after_ms": 600,
      "text": "Martin retourne le paquet entre ses doigts. Le sceau lui paraît presque décevant : un petit morceau de cire marqué d'une empreinte. Pourtant, au Moyen Âge, un sceau n'est pas un décor. Il sert à authentifier un acte. Il relie une parole écrite à celui qui l'a validée. Martin sait peu lire. Mais il comprend très bien une chose : s'il brise cette cire, il ne pourra pas la remettre comme avant.",
      "preset": "conteuse-chaleureuse"
    },
    {
      "scene": "4 — Ce qui ferme une parole",
