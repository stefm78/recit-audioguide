      "voice": "fr-FR-RemyMultilingualNeural",
      "rate": "+7%",
      "pitch": "+25Hz",
      "volume": "+3%"
    },
    {
      "scene": "3 — Le paquet",
      "character_id": "etienne",
      "speaker": "Étienne",
      "pause_after_ms": 180,
      "text": "Maître Guillaume saura à qui le remettre.",
      "preset": "marin-bourru"
    },
    {
      "scene": "3 — Le paquet",
      "character_id": "martin",
      "speaker": "Martin",
      "pause_after_ms": 220,
      "text": "Et qu'est-ce qu'il y a dedans ?",
      "voice": "fr-FR-RemyMultilingualNeural",
      "rate": "+7%",
      "pitch": "+25Hz",
      "volume": "+3%"
    },
    {
      "scene": "3 — Le paquet",
      "character_id": "etienne",
      "speaker": "Étienne",
      "pause_after_ms": 350,
      "text": "Tu n'as pas besoin de le savoir.",
      "preset": "marin-bourru"
    },
    {
      "scene": "3 — Le paquet",
      "character_id": "martin",
      "speaker": "Martin",
      "pause_after_ms": 240,
      "text": "Donc c'est important.",
      "voice": "fr-FR-RemyMultilingualNeural",
      "rate": "+9%",
      "pitch": "+26Hz",
      "volume": "+3%"
    },
    {
      "scene": "3 — Le paquet",
      "character_id": "etienne",
      "speaker": "Étienne",
      "pause_after_ms": 500,
      "text": "Tout devient important dès que je te dis de ne pas y toucher.",
      "preset": "marin-bourru"
    },
    {
      "scene": "3 — Le paquet",
      "character_id": "agnes",
      "speaker": "Agnès",
      "pause_after_ms": 500,
      "text": "C'est à propos de mon père ?",
      "voice": "fr-FR-EloiseNeural",
      "rate": "-1%",
      "pitch": "-4Hz",
