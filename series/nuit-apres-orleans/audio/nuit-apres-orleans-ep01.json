    },
    {
      "scene": "Prologue — sous la table",
      "character_id": "narrateur",
      "speaker": "Narratrice",
      "pause_after_ms": 650,
      "text": "La femme ne discute pas. Elle lui attrape le poignet et le tire vers l'escalier. Quand Martin remonte dans la lumière, il comprend que quelque chose a changé.",
      "preset": "conteuse-chaleureuse",
