      "speaker": "La marchande",
      "preset": "marchande-truculente",
      "rate": "-4%",
      "pitch": "+2Hz",
      "volume": "-6%",
      "placement": "left",
      "acoustic_space": "outdoor-open",
      "pause_after_ms": 350,
      "text": "Oui, oui... j’ai compris."
    },
    {
      "character_id": "sentinelle",
      "speaker": "La sentinelle",
      "preset": "sentinelle-nerveuse",
      "rate": "-10%",
      "pitch": "-4Hz",
