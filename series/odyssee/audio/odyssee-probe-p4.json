    },
    {
      "scene": "P4 — reconnaissance",
      "character_id": "sirene",
      "speaker": "Sirène",
      "pause_after_ms": 180,
      "text": "Ulysse d’Ithaque. Nous savons d’où tu viens. Nous savons ce que tu as fait devant Troie.",
      "voice": "fr-FR-VivienneMultilingualNeural",
      "rate": "-4%",
      "pitch": "+0Hz",
