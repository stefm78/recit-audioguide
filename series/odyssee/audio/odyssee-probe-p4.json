    {
      "scene": "P4 — bateau réel",
      "character_id": "ulysse",
      "speaker": "Ulysse",
      "pause_after_ms": 160,
      "text": "J’ai regardé mes compagnons. Ils ramaient. Ils n’entendaient rien.",
      "voice": "fr-FR-HenriNeural",
      "rate": "-4%",
      "pitch": "-10Hz",
      "volume": "+2%"
    },
    {
      "scene": "P4 — proposition",
      "character_id": "sirene",
      "speaker": "Sirène",
      "pause_after_ms": 260,
      "text": "Viens. Tu n’as pas besoin de rentrer pour être connu. Ton nom est déjà arrivé plus loin que toi.",
      "voice": "fr-FR-VivienneMultilingualNeural",
      "rate": "-4%",
      "pitch": "+0Hz",
      "volume": "-4%"
    },
    {
      "scene": "P4 — cordes",
      "character_id": "ulysse",
      "speaker": "Ulysse",
      "pause_after_ms": 140,
      "text": "J’ai tiré sur les cordes.",
      "voice": "fr-FR-HenriNeural",
      "rate": "-4%",
      "pitch": "-10Hz",
      "volume": "+2%"
    },
    {
      "scene": "P4 — cordes",
      "character_id": "euryloque",
      "speaker": "Euryloque",
      "pause_after_ms": 170,
      "text": "Tu as crié beaucoup de choses.",
      "voice": "fr-FR-HenriNeural",
      "rate": "+4%",
      "pitch": "-14Hz",
      "volume": "+8%"
    },
    {
      "scene": "P4 — piège",
      "character_id": "sirene",
      "speaker": "Sirène",
      "pause_after_ms": 230,
      "text": "Ils t’oublieront chez toi. Ici, nous savons tout. Ici, rien de ce que tu as fait ne disparaît.",
      "voice": "fr-FR-VivienneMultilingualNeural",
      "rate": "-4%",
      "pitch": "+0Hz",
