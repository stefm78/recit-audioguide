          "pan": 0.05,
          "pause_after_ms": 230
        },
        {
          "speaker": "Ulysse",
          "provider": "edge",
          "text": "Je ne savais pas.",
          "voice": "fr-FR-HenriNeural",
          "rate": "-4%",
          "pitch": "-10Hz",
          "volume": "+2%",
          "pause_after_ms": 160
        },
        {
          "speaker": "Anticlée",
          "provider": "chatterbox",
          "ref": "vivienne",
          "text": "Non. Cela change quelque chose ?",
          "exaggeration": 0.35,
          "cfg_weight": 0.48,
          "temperature": 0.75,
          "pan": 0.05,
          "pause_after_ms": 200
        },
        {
          "speaker": "Ulysse",
          "provider": "edge",
          "text": "Pour moi, oui.",
          "voice": "fr-FR-HenriNeural",
          "rate": "-4%",
          "pitch": "-10Hz",
          "volume": "+2%",
          "pause_after_ms": 160
        },
        {
          "speaker": "Anticlée",
          "provider": "chatterbox",
          "ref": "vivienne",
          "text": "Alors il y a longtemps.",
          "exaggeration": 0.34,
          "cfg_weight": 0.5,
          "temperature": 0.74,
          "pan": 0.05,
          "pause_after_ms": 240
        },
        {
          "speaker": "Ulysse",
          "provider": "edge",
          "text": "Pénélope ?",
          "voice": "fr-FR-HenriNeural",
          "rate": "-4%",
          "pitch": "-10Hz",
          "volume": "+2%",
          "pause_after_ms": 120
        },
        {
          "speaker": "Anticlée",
          "provider": "chatterbox",
          "ref": "vivienne",
          "text": "Elle tient.",
          "exaggeration": 0.34,
          "cfg_weight": 0.5,
          "temperature": 0.74,
          "pan": 0.05,
          "pause_after_ms": 150
        },
        {
          "speaker": "Ulysse",
          "provider": "edge",
          "text": "Télémaque ?",
          "voice": "fr-FR-HenriNeural",
          "rate": "-4%",
          "pitch": "-10Hz",
          "volume": "+2%",
          "pause_after_ms": 120
        },
        {
          "speaker": "Anticlée",
          "provider": "chatterbox",
          "ref": "vivienne",
          "text": "Il n’est plus l’enfant que tu as laissé.",
          "exaggeration": 0.34,
          "cfg_weight": 0.5,
          "temperature": 0.74,
          "pan": 0.05,
          "pause_after_ms": 250
        },
        {
          "speaker": "Ulysse",
          "provider": "edge",
          "text": "J’ai voulu la toucher.",
          "voice": "fr-FR-HenriNeural",
          "rate": "-4%",
          "pitch": "-10Hz",
          "volume": "+2%",
          "pause_after_ms": 180
        },
        {
          "speaker": "Narratrice",
          "provider": "edge",
          "text": "Dans la salle des Phéaciens, ses mains se ferment l’une contre l’autre.",
          "voice": "fr-FR-DeniseNeural",
          "rate": "-5%",
          "pitch": "-8Hz",
          "volume": "+1%",
          "pause_after_ms": 230
        },
        {
          "speaker": "Ulysse",
          "provider": "edge",
          "text": "Mes bras ont traversé son absence.",
          "voice": "fr-FR-HenriNeural",
          "rate": "-4%",
          "pitch": "-10Hz",
          "volume": "+2%",
          "pause_after_ms": 250
        },
        {
          "speaker": "Ulysse",
          "provider": "edge",
          "text": "J’ai essayé encore.",
          "voice": "fr-FR-HenriNeural",
          "rate": "-4%",
          "pitch": "-10Hz",
          "volume": "+2%",
          "pause_after_ms": 150
        },
        {
          "speaker": "Anticlée",
          "provider": "chatterbox",
          "ref": "vivienne",
          "text": "Ulysse. Arrête.",
          "exaggeration": 0.34,
          "cfg_weight": 0.5,
          "temperature": 0.74,
          "pan": 0.05,
          "pause_after_ms": 210
        },
        {
          "speaker": "Ulysse",
          "provider": "edge",
          "text": "Je voulais seulement…",
          "voice": "fr-FR-HenriNeural",
          "rate": "-4%",
          "pitch": "-10Hz",
          "volume": "+2%",
          "pause_after_ms": 150
        },
        {
          "speaker": "Anticlée",
          "provider": "chatterbox",
          "ref": "vivienne",
          "text": "Je sais, mon fils.",
          "exaggeration": 0.34,
          "cfg_weight": 0.5,
          "temperature": 0.74,
          "pan": 0.05,
          "pause_after_ms": 300
        },
        {
          "speaker": "Narratrice",
          "provider": "edge",
          "text": "Le conteur qui avait souri en racontant le nom de Personne ne sourit plus.",
          "voice": "fr-FR-DeniseNeural",
          "rate": "-5%",
          "pitch": "-8Hz",
          "volume": "+1%",
          "pause_after_ms": 240
        },
        {
          "speaker": "Ulysse",
          "provider": "edge",
          "text": "Pour la première fois, je ne voulais plus connaître la prochaine aventure. Je voulais la dernière.",
          "voice": "fr-FR-HenriNeural",
          "rate": "-4%",
          "pitch": "-10Hz",
          "volume": "+2%",
          "pause_after_ms": 260
        }
      ]
    },
