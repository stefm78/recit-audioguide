    "p6-a": {
      "module": "P6",
      "title": "Le lit — Ulysse Azure retenu",
      "segments": [
        {
          "speaker": "Pénélope",
          "provider": "chatterbox",
          "ref": "vivienne",
          "text": "Euryclée. Prépare le lit d’Ulysse dans le couloir.",
          "exaggeration": 0.48,
          "cfg_weight": 0.42,
          "temperature": 0.76,
          "pan": 0.04,
