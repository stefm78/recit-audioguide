        },
        {
          "speaker": "Ulysse",
          "provider": "azure",
          "voice": "fr-FR-HenriNeural",
          "locale": "fr-FR",
          "text": "Non.",
          "rate": "+2%",
          "pitch": "-10Hz",
          "volume": "+3%",
          "style": "excited",
          "styledegree": 0.65,
          "pause_after_ms": 180
        },
        {
          "speaker": "Pénélope",
          "provider": "chatterbox",
          "ref": "vivienne",
          "text": "Non ?",
          "exaggeration": 0.45,
          "cfg_weight": 0.44,
          "temperature": 0.75,
          "pan": 0.04,
          "pause_after_ms": 140
        },
        {
          "speaker": "Ulysse",
          "provider": "azure",
          "voice": "fr-FR-HenriNeural",
          "locale": "fr-FR",
          "text": "Ce lit ne sort pas de cette chambre.",
          "rate": "-2%",
          "pitch": "-10Hz",
          "volume": "+2%",
          "style": "excited",
          "styledegree": 0.58,
          "pause_after_ms": 170
        },
        {
          "speaker": "Pénélope",
          "provider": "chatterbox",
          "ref": "vivienne",
          "text": "Pourquoi ?",
          "exaggeration": 0.45,
          "cfg_weight": 0.44,
          "temperature": 0.75,
          "pan": 0.04,
          "pause_after_ms": 180
        },
        {
          "speaker": "Ulysse",
          "provider": "azure",
          "voice": "fr-FR-HenriNeural",
          "locale": "fr-FR",
          "text": "Parce que l’un de ses pieds est un olivier.",
          "rate": "-3%",
          "pitch": "-10Hz",
          "volume": "+2%",
          "pause_after_ms": 140
        },
        {
          "speaker": "Ulysse",
          "provider": "azure",
          "voice": "fr-FR-HenriNeural",
          "locale": "fr-FR",
          "text": "Il était vivant quand j’ai construit la chambre.",
          "rate": "-3%",
          "pitch": "-10Hz",
          "volume": "+2%",
          "pause_after_ms": 120
        },
        {
          "speaker": "Ulysse",
          "provider": "azure",
          "voice": "fr-FR-HenriNeural",
          "locale": "fr-FR",
          "text": "J’ai taillé le tronc. J’ai bâti les murs autour.",
          "rate": "-3%",
          "pitch": "-10Hz",
          "volume": "+2%",
          "pause_after_ms": 850
        },
        {
          "speaker": "Pénélope",
          "provider": "chatterbox",
          "ref": "vivienne",
          "text": "Alors personne ne l’a déplacé.",
          "exaggeration": 0.44,
          "cfg_weight": 0.46,
          "temperature": 0.74,
          "pan": 0.04,
          "pause_after_ms": 260
        },
        {
          "speaker": "Ulysse",
          "provider": "azure",
          "voice": "fr-FR-HenriNeural",
          "locale": "fr-FR",
          "text": "Tu le savais.",
          "rate": "-4%",
          "pitch": "-10Hz",
          "volume": "+2%",
          "style": "sad",
          "styledegree": 0.72,
          "pause_after_ms": 220
        },
        {
          "speaker": "Pénélope",
          "provider": "chatterbox",
          "ref": "vivienne",
          "text": "Je devais savoir si toi, tu le savais encore.",
          "exaggeration": 0.5,
          "cfg_weight": 0.4,
          "temperature": 0.76,
          "pan": 0.04,
          "pause_after_ms": 760
        },
        {
          "speaker": "Ulysse",
          "provider": "azure",
          "voice": "fr-FR-HenriNeural",
          "locale": "fr-FR",
          "text": "Pénélope…",
          "rate": "-6%",
          "pitch": "-10Hz",
          "volume": "+1%",
          "style": "sad",
          "styledegree": 0.78,
          "pause_after_ms": 300
        },
        {
          "speaker": "Pénélope",
          "provider": "chatterbox",
          "ref": "vivienne",
          "text": "Ulysse.",
          "exaggeration": 0.46,
          "cfg_weight": 0.44,
          "temperature": 0.74,
          "pan": 0.04,
          "pause_after_ms": 480
        },
        {
          "speaker": "Pénélope",
          "provider": "chatterbox",
          "ref": "vivienne",
          "text": "Je n’avais besoin que d’une chose qui ne puisse pas voyager avec tes histoires.",
          "exaggeration": 0.5,
          "cfg_weight": 0.4,
          "temperature": 0.76,
          "pan": 0.04,
          "pause_after_ms": 260
        },
        {
          "speaker": "Ulysse",
          "provider": "azure",
          "voice": "fr-FR-HenriNeural",
          "locale": "fr-FR",
          "text": "Notre lit.",
          "rate": "-5%",
          "pitch": "-10Hz",
          "volume": "+1%",
          "style": "sad",
          "styledegree": 0.6,
          "pause_after_ms": 200
        },
        {
          "speaker": "Pénélope",
          "provider": "chatterbox",
          "ref": "vivienne",
          "text": "Notre lit.",
