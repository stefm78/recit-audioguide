    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Qu’y a-t-il ?",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "euryclee",
      "speaker": "EURYCLÉE",
      "text": "Viens.",
      "preset": "odyssee-euryclee-h2"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Tu trembles.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "euryclee",
      "speaker": "EURYCLÉE",
      "text": "Il est revenu.",
      "preset": "odyssee-euryclee-h2"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Qui ?",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "euryclee",
      "speaker": "EURYCLÉE",
      "text": "Tu le sais.",
      "preset": "odyssee-euryclee-h2"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Non.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "euryclee",
      "speaker": "EURYCLÉE",
      "text": "Ulysse.",
      "preset": "odyssee-euryclee-h2"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Pénélope ne se lève pas.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "euryclee",
      "speaker": "EURYCLÉE",
      "text": "Il est en bas.",
      "preset": "odyssee-euryclee-h2"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Beaucoup d’hommes ont été en bas.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "euryclee",
      "speaker": "EURYCLÉE",
      "text": "C’est lui.",
      "preset": "odyssee-euryclee-h2"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Tu l’as reconnu ?",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "euryclee",
      "speaker": "EURYCLÉE",
      "text": "Oui.",
      "preset": "odyssee-euryclee-h2"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Comment ?",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "euryclee",
      "speaker": "EURYCLÉE",
      "text": "La cicatrice.",
      "preset": "odyssee-euryclee-h2"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Une cicatrice se décrit.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "euryclee",
      "speaker": "EURYCLÉE",
      "text": "Je connais celle-là depuis qu’il est jeune.",
      "preset": "odyssee-euryclee-h2"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Et les prétendants ?",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "euryclee",
      "speaker": "EURYCLÉE",
      "text": "Morts.",
      "preset": "odyssee-euryclee-h2"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Pénélope ferme les yeux.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "euryclee",
      "speaker": "EURYCLÉE",
      "text": "Tu ne me crois pas.",
      "preset": "odyssee-euryclee-h2"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Je te crois.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "euryclee",
      "speaker": "EURYCLÉE",
      "text": "Alors viens.",
      "preset": "odyssee-euryclee-h2"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Je crois que tu as reconnu une cicatrice. Je crois que les prétendants sont morts. Je ne sais pas encore ce que je dois croire du reste.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "euryclee",
      "speaker": "EURYCLÉE",
      "text": "Pénélope—",
      "preset": "odyssee-euryclee-h2"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Depuis vingt ans, chaque homme qui m’apporte une nouvelle veut que je sois soulagée avant de vérifier si elle est vraie.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "euryclee",
      "speaker": "EURYCLÉE",
      "text": "Lui ne t’a rien demandé.",
      "preset": "odyssee-euryclee-h2"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Hier, il m’a menti en face.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "euryclee",
      "speaker": "EURYCLÉE",
      "text": "Pour se protéger.",
      "preset": "odyssee-euryclee-h2"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "C’est exactement ce qu’aurait fait Ulysse.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "euryclee",
      "speaker": "EURYCLÉE",
      "text": "Alors ?",
      "preset": "odyssee-euryclee-h2"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Alors cela prouve qu’il lui ressemble.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Elle se lève.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "En bas, Ulysse attend.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Il a attendu des années sur des rivages étrangers.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Il découvre qu’attendre quelques pas dans sa propre maison est une autre forme d’épreuve.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Télémaque.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "telemaque",
      "speaker": "TÉLÉMAQUE",
      "text": "Mère.",
      "preset": "odyssee-telemaque"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Tu vas bien ?",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "telemaque",
      "speaker": "TÉLÉMAQUE",
      "text": "Oui.",
      "preset": "odyssee-telemaque"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Tu es sûr ?",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "telemaque",
      "speaker": "TÉLÉMAQUE",
      "text": "Père m’a déjà posé la question.",
      "preset": "odyssee-telemaque"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Le mot tombe dans la pièce.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Père.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "telemaque",
      "speaker": "TÉLÉMAQUE",
      "text": "Oui.",
      "preset": "odyssee-telemaque"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Tu es sûr ?",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "telemaque",
      "speaker": "TÉLÉMAQUE",
      "text": "Je l’ai vu changer d’apparence.",
      "preset": "odyssee-telemaque"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Athéna ?",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "telemaque",
      "speaker": "TÉLÉMAQUE",
      "text": "Oui.",
      "preset": "odyssee-telemaque"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Tu lui as parlé ?",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "telemaque",
      "speaker": "TÉLÉMAQUE",
      "text": "À Athéna ?",
      "preset": "odyssee-telemaque"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "À lui.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "telemaque",
      "speaker": "TÉLÉMAQUE",
      "text": "Oui.",
      "preset": "odyssee-telemaque"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Et tu le crois.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "telemaque",
      "speaker": "TÉLÉMAQUE",
      "text": "Oui.",
      "preset": "odyssee-telemaque"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Bien.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "telemaque",
      "speaker": "TÉLÉMAQUE",
      "text": "Bien ?",
      "preset": "odyssee-telemaque"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Je suis heureuse pour toi.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "telemaque",
      "speaker": "TÉLÉMAQUE",
      "text": "Pour moi ?",
      "preset": "odyssee-telemaque"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Tu as trouvé ton père.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "telemaque",
      "speaker": "TÉLÉMAQUE",
      "text": "Mère, c’est ton mari.",
      "preset": "odyssee-telemaque"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Je sais qui il dit être.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Pénélope.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Elle regarde enfin l’homme.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Athéna lui a rendu son visage.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Mais vingt années ne se retirent pas avec un déguisement.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Ulysse a des lignes que Pénélope n’a jamais vues. Pénélope a une manière de tenir ses épaules qu’Ulysse ne connaît pas.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Ils se reconnaissent assez pour avoir peur de se tromper.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Je suis revenu.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Je vois.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "C’est tout ?",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Qu’attendais-tu ?",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Je ne sais pas.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Voilà une réponse que je n’entendais pas souvent autrefois.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Tu peux demander ce que tu veux.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Je sais.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "La cicatrice.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Euryclée l’a vue.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Télémaque.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Il te croit.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Athéna.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Elle a déjà pris beaucoup de visages.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Tu penses que je suis un imposteur ?",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Je pense que tu es un homme qui sait des choses sur Ulysse.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Je suis Ulysse.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "penelope",
      "speaker": "PÉNÉLOPE",
      "text": "Tu l’as dit.",
      "preset": "odyssee-penelope"
    },
    {
      "scene": "S15 — Le lit",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Regarde-moi.",
