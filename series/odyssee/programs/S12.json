    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "telemaque",
      "speaker": "TÉLÉMAQUE",
      "text": "Elle a entendu trop d’hommes promettre ton retour. Si tu veux qu’elle te croie, ne lui demande pas de te croire.",
