  "segments": [
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Athéna ne rend pas Ulysse invisible.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Elle fait quelque chose de plus utile.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Elle le rend regardable sans être reconnu.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Mes mains.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "athena",
      "speaker": "ATHÉNA",
      "text": "Quoi, tes mains ?",
      "preset": "odyssee-athena"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Elles ont l’air plus vieilles.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "athena",
      "speaker": "ATHÉNA",
      "text": "Elles sont plus vieilles.",
      "preset": "odyssee-athena"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Pas à ce point.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "athena",
      "speaker": "ATHÉNA",
      "text": "Tu as réclamé un déguisement, pas un compliment.",
      "preset": "odyssee-athena"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Et mon visage ?",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "athena",
      "speaker": "ATHÉNA",
      "text": "Si Pénélope te croisait maintenant sur un chemin, elle ne verrait pas son mari.",
      "preset": "odyssee-athena"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "C’est censé me rassurer ?",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "athena",
      "speaker": "ATHÉNA",
      "text": "C’est censé te garder vivant.",
      "preset": "odyssee-athena"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Je pourrais entrer avec une arme.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "athena",
      "speaker": "ATHÉNA",
      "text": "Dans une salle pleine d’hommes qui vivent depuis des années dans ta maison ?",
      "preset": "odyssee-athena"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "C’est précisément pour cela.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "athena",
      "speaker": "ATHÉNA",
      "text": "Tu veux retrouver ton royaume ou mourir avec une belle première phrase ?",
      "preset": "odyssee-athena"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Je n’avais pas préparé de phrase.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "athena",
      "speaker": "ATHÉNA",
      "text": "Voilà au moins un progrès.",
      "preset": "odyssee-athena"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Elle lui indique une ferme à l’écart.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "athena",
      "speaker": "ATHÉNA",
      "text": "Va chez Eumée.",
      "preset": "odyssee-athena"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Il est encore là ?",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "athena",
      "speaker": "ATHÉNA",
      "text": "Oui.",
      "preset": "odyssee-athena"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Il me reconnaîtra.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "athena",
      "speaker": "ATHÉNA",
      "text": "Non.",
      "preset": "odyssee-athena"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Tu es sûre de ton travail.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "athena",
      "speaker": "ATHÉNA",
      "text": "Beaucoup plus que toi du tien.",
      "preset": "odyssee-athena"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Eumée garde les porcs d’Ulysse depuis bien avant le départ pour Troie.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Quand il voit approcher le vieil étranger mal vêtu, il ne court pas chercher des hommes armés.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Il appelle ses chiens.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Ici !",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Les chiens s’arrêtent.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Tu cherches quelque chose ?",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Un endroit où m’asseoir sans être mordu.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Ça, je peux te le trouver.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Et un peu de nourriture, si je peux travailler pour.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Entre d’abord.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Tu accueilles toujours les inconnus comme ça ?",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Non.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Pourquoi moi ?",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Parce que tu as l’air d’avoir marché assez longtemps pour ne pas avoir choisi cette tête-là exprès.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Eumée lui donne du pain, de la viande, une place près du feu.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Ton maître ne te reprochera pas de nourrir un inconnu avec ses bêtes ?",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Mon maître ?",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Celui à qui appartient cette terre.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Ulysse.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Oui.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "S’il revient, il pourra me reprocher ce qu’il voudra.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Tu penses qu’il reviendra ?",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Je pense surtout que tous les hommes qui passent par ici savent très bien me raconter où ils l’ont vu.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Ah.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Tu vas me dire que toi aussi ?",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Je pourrais.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Alors mange d’abord. Les mensonges sont meilleurs le ventre plein.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Tu n’en crois aucun ?",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "J’en ai cru assez.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Et pourtant tu parles encore de lui comme de ton maître.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Une absence ne change pas tout.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Vingt ans, c’est plus qu’une absence.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Pour certains.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Et sa maison ?",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Mangée vivante.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Par les prétendants.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Tu connais donc l’histoire.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Elle voyage.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Eux aussi voyagent. Entre la salle et la réserve.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Pénélope ?",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Tient encore.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Télémaque ?",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Revient bientôt, si les dieux sont moins stupides que d’habitude.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Où était-il ?",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Chercher son père.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Son père ?",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Oui. Tu vois, l’histoire voyage dans les deux sens.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Ulysse baisse les yeux vers le pain.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Il pourrait dire la vérité.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Il sait désormais combien un nom peut coûter.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Alors il invente.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "J’ai entendu parler d’Ulysse.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Évidemment.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "On m’a dit qu’il vivait.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Évidemment.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Et qu’il cherchait un moyen de rentrer.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Évidemment.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Tu pourrais varier tes réponses.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Les histoires, elles, varient assez.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "ulysse",
      "speaker": "ULYSSE",
      "text": "Celle-ci est vraie.",
      "preset": "odyssee-ulysse"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Elles le sont toutes, jusqu’au départ du conteur.",
      "preset": "odyssee-eumee-h2"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "narratrice",
      "speaker": "NARRATRICE",
      "text": "Ulysse sourit malgré lui.",
      "preset": "odyssee-narratrice"
    },
    {
      "scene": "S12 — Personne, une seconde fois",
      "character_id": "eumee",
      "speaker": "EUMÉE",
      "text": "Quoi ?",
