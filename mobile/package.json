{
  "name": "recit-audioguide-mobile-spike",
  "private": true,
  "version": "0.4.0",
  "description": "Shared-shell offline-first MVP for Récit audioguide",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:web": "node prepare-web.mjs",
    "freeze:seville": "node freeze-series.mjs seville-discovery",
    "finalize:runtime": "node finalize-runtime.mjs seville-discovery",
    "verify:offline": "node verify-offline.mjs seville-discovery",
    "verify:runtime": "node verify-runtime.mjs seville-discovery",
    "verify:runtime-browser": "node verify-runtime-browser.mjs seville-discovery",
    "prepare:offline-seville": "npm run prepare:web && npm run freeze:seville && npm run finalize:runtime && npm run verify:offline && npm run verify:runtime && npm run verify:runtime-browser",
    "cap:sync:android": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "8.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.0.0",
    "@capacitor/cli": "8.0.0",
    "@capacitor/ios": "8.0.0",
    "jsdom": "26.1.0"
  }
}
